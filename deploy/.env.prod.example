# Copy to ~/academies/.env on the server (never commit it) and replace every "change-me".
# Generate secrets with: openssl rand -hex 24

# Public host name pointing at the server, e.g. academies.duckdns.org or 1-2-3-4.sslip.io
DOMAIN=change-me.duckdns.org

# Set by the deploy workflow; only needed here for manual `docker compose` runs.
IMAGE_PREFIX=ghcr.io/waleedhassanien/academies-platform
IMAGE_TAG=latest

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=academies
MYSQL_USER=academies
MYSQL_PASSWORD=change-me

RABBITMQ_USER=academies
RABBITMQ_PASSWORD=change-me

INTERNAL_API_KEY=change-me
MEETINGS_ROOM_SECRET=change-me

# SuperAdmin created on first start (seeding only adds what is missing).
SEED_SUPERADMIN_EMAIL=superadmin@academies.local
SEED_SUPERADMIN_PASSWORD=change-me
# true also creates "Demo Academy" with admin@demo.academies.local / SEED_DEMO_ADMIN_PASSWORD.
SEED_DEMO_ACADEMY=false
SEED_DEMO_ADMIN_PASSWORD=

# Empty host = emails only go to the service logs.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@academies.local

PAYMENTS_PROVIDER=Fake
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_EGP_TO_USD=0.0206
