{
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/identity/auth/{action:regex(^(login|forgot-password|reset-password)$)}" },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "subscription": {
        "ClusterId": "subscription",
        "Match": { "Path": "/api/subscriptions/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/subscriptions" } ]
      },
      "academic": {
        "ClusterId": "academic",
        "Match": { "Path": "/api/academic/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/academic" } ]
      },
      "finance": {
        "ClusterId": "finance",
        "Match": { "Path": "/api/finance/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/finance" } ]
      },
      "engagement": {
        "ClusterId": "engagement",
        "Match": { "Path": "/api/engagement/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/engagement" } ]
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5101" } } },
      "subscription": { "Destinations": { "d1": { "Address": "http://localhost:5102" } } },
      "academic": { "Destinations": { "d1": { "Address": "http://localhost:5103" } } },
      "finance": { "Destinations": { "d1": { "Address": "http://localhost:5104" } } },
      "engagement": { "Destinations": { "d1": { "Address": "http://localhost:5105" } } }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
