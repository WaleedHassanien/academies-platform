# Copy to .env (git-ignored) and change for anything beyond local dev.
ASPNETCORE_ENVIRONMENT=Development

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=academies
MYSQL_USER=academies
MYSQL_PASSWORD=academies

RABBITMQ_USER=academies
RABBITMQ_PASSWORD=academies

# Seeded accounts (Identity seeds only in Development).
SEED_SUPERADMIN_PASSWORD=SuperAdmin!2026
SEED_DEMO_ADMIN_PASSWORD=Admin!2026

# Shared secret for service-to-service /internal calls.
INTERNAL_API_KEY=dev-internal-key-change-me

# Email (empty host = emails are written to the service log).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Online payments (US-039): Fake (dev, pays instantly) or PayPal.
PAYMENTS_PROVIDER=Fake
# From developer.paypal.com > Apps & Credentials. Mode: sandbox or live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Webhook id for POST /api/finance/payments/webhooks/paypal (events: CHECKOUT.ORDER.APPROVED,
# PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED).
PAYPAL_WEBHOOK_ID=
# PayPal can't charge EGP: EGP months are charged in USD at this rate (1 EGP in USD).
PAYPAL_EGP_TO_USD=0.0206
